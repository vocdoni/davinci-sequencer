# ====================================================================
# davinci-sequencer: environment for docker compose
# ====================================================================
# Copy to .env. Every node flag has a DAVINCI_* variable (--rpc-url is
# DAVINCI_RPC_URL). An empty value is not the same as unset: the node
# rejects DAVINCI_START_BLOCK= and similar, so leave unused variables
# commented out. Durations take 90, 90s, 500ms, 5m or 2h.

# ============================================================
# Chain: REQUIRED
# ============================================================

# ProcessRegistry address (davinci-contracts, branch zkvm).
DAVINCI_REGISTRY=

# Blob source for transitions this node did not send:
# beacon:<url>[,<url>...] (consensus-layer beacon APIs) or anvil.
DAVINCI_BLOB_SOURCE=

# Execution-layer JSON-RPC, comma-separated for failover.
# The default, http://127.0.0.1:8545, is the container itself.
DAVINCI_RPC_URL=

# First block a fresh datadir scans for registry events: the registry's
# deployment block. Unset scans from block 0.
# DAVINCI_START_BLOCK=

# Blocks behind head treated as final. Default 2; use 3 on Gnosis.
# DAVINCI_CONFIRMATIONS=2

# Most blobs per settlement transaction (1 to 6). Unset: from eth_config.
# DAVINCI_MAX_BLOBS_PER_TX=

# ============================================================
# Signing key
# ============================================================

# Host path of the file holding the hex secp256k1 key that signs settlement
# transactions. Compose mounts it as a secret and points DAVINCI_PRIVKEY_FILE
# at it. The container runs as uid 10001, so:
#   sudo install -o 10001 -m 0400 /path/to/key sequencer.key
# An empty file runs the node as an observer (no settlement, no /votes).
SEQUENCER_KEY_FILE=./sequencer.key

# DAVINCI_PRIVKEY_FILE is set by compose. DAVINCI_PRIVKEY (the key itself in
# the environment) is the node's alternative; don't set it here, the node
# refuses both at once.

# ============================================================
# Prover
# ============================================================

# davinci-zkvm prover service for the prod and dev profiles. A prover
# published on this host is http://host.docker.internal:8080 (it must listen
# on the Docker bridge, not only on 127.0.0.1). The gpu and prod-gpu profiles
# override this with their own prover.
DAVINCI_PROVER_URL=http://host.docker.internal:8080

# Prover job polling interval and the longest wait for one job.
# DAVINCI_PROVER_POLL=2s
# DAVINCI_PROVER_TIMEOUT=30m

# ============================================================
# Batching and timing
# ============================================================

# Pending votes that seal a batch without waiting (1 to 1024).
# DAVINCI_BATCH_MAX=1024

# Longest a pending vote waits before its batch is sealed.
# DAVINCI_BATCH_TIME=5m

# No batch is sealed when the election ends within this margin.
# DAVINCI_SETTLE_MARGIN=120s

# Chain polling interval, and the actor heartbeat (default: poll interval).
# DAVINCI_POLL_INTERVAL=5s
# DAVINCI_HEARTBEAT=

# ============================================================
# API
# ============================================================

# API listen address and port. Compose publishes the same port on the host.
# DAVINCI_API_HOST=0.0.0.0
DAVINCI_API_PORT=9090

# POST /processes/keys per client IP per minute.
# DAVINCI_KEYS_PER_MINUTE=10

# ============================================================
# Census and ballots
# ============================================================

# Directory file:// census URIs may read from, inside the container (mount
# it yourself). Unset: file:// is refused.
# DAVINCI_CENSUS_DIR=

# Allow census downloads from loopback and private addresses (local dev).
# DAVINCI_CENSUS_ALLOW_PRIVATE=true

# Largest census accepted, in participants.
# DAVINCI_CENSUS_MAX_PARTICIPANTS=4194304

# Ballot proof VK JSON, inside the container. Default: the SDK's embedded
# key. Its hash must equal the registry's ballotVKHash.
# DAVINCI_BALLOT_VK=

# ============================================================
# Logging and storage
# ============================================================

# Tracing filter; RUST_LOG takes precedence.
DAVINCI_LOG_LEVEL=info
# RUST_LOG=

# Set by compose to /data, a named volume. It holds the node master secret:
# back it up.
# DAVINCI_DATADIR=/data

# ============================================================
# Compose
# ============================================================

# Image tag of ghcr.io/vocdoni/davinci-sequencer.
# DAVINCI_SEQUENCER_TAG=main

# Restart policy of the long-running services.
# RESTART=unless-stopped

# Domain for the Let's Encrypt certificate (prod and prod-gpu profiles).
DOMAIN=

# Traefik image tag.
# TRAEFIK_TAG=v3

# ============================================================
# GPU prover (gpu and prod-gpu profiles)
# ============================================================

# ZisK proving keys, as installed by `make keys` in davinci-zkvm
# (provingKey/ and provingKeySnark/ below this directory).
# ZISK_KEYS_DIR=../davinci-zkvm/zisk-keys

# ZisK release the prover image is built against.
# ZISK_TAG=v1.3.0-alpha

# Prover queue and MPI settings; see the davinci-zkvm README.
# MAX_QUEUE_SIZE=100
# ZISK_MPI_PROCS=1
# ZISK_MPI_THREADS=0
# ZISK_MPI_BIND_TO=none

# --minimal-memory from the first attempt: always (1), or for batches of at
# least ZISK_MINIMAL_MEMORY_FROM proofs.
# ZISK_MINIMAL_MEMORY=0
# ZISK_MINIMAL_MEMORY_FROM=512
